# Mother & Baby — copy to .env; do NOT commit credentials.
# DATABASE_MODE: mock | docker | supabase | both
DATABASE_MODE=mock
# Compatibility: CONTENT_PROVIDER=postgres and DATABASE_URL still work for Docker.
# DOCKER_DATABASE_URL=postgresql://mebe:local-only-change-me@127.0.0.1:5432/mebe
# Supabase Dashboard -> Connect -> Session Pooler (port 5432) for IPv4.
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# For verified TLS, download a root CA from Supabase Database settings.
# SUPABASE_CA_CERT_PATH=/secure/path/supabase-ca.crt
# BOTH mode requires explicit primary, and DB_TARGET for migrations / seed.
# DATABASE_MODE=both
# DATABASE_PRIMARY=docker
# DB_TARGET=supabase
PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTENT_API_URL=http://localhost:4000
# Dev-only CMS keys (three distinct random strings >=24 chars)
EDITORIAL_DEMO_WRITER_TOKEN=
EDITORIAL_DEMO_EDITOR_TOKEN=
EDITORIAL_DEMO_REVIEWER_TOKEN=
