# Copy to projects/hanh-trinh-me-be/.env. Keep local, NEVER commit.
CONTENT_PROVIDER=mock  # set postgres after migration+seed
PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTENT_API_URL=http://localhost:4000

# REQUIRED to use /admin in development. Generate three distinct random values,
# each at least 24 characters; never use these local tokens in production.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDITORIAL_DEMO_WRITER_TOKEN=
EDITORIAL_DEMO_EDITOR_TOKEN=
EDITORIAL_DEMO_REVIEWER_TOKEN=

# Reserved for later PostgreSQL adapter (unused in mock phase).
# DATABASE_URL=postgresql://mebe:local-only-change-me@127.0.0.1:5432/mebe
# Run `docker compose -f compose.postgres.yml up -d`, then db:migrate + db:seed.
