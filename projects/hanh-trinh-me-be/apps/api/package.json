{
  "name": "@mebe/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test src/*.test.ts",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "db:seed": "tsx src/db/run-seed.ts",
    "test:postgres": "tsx --test src/postgres.integration.ts",
    "db:status": "tsx src/db/run-status.ts",
    "test:db-routing": "tsx --test src/db-routing.integration.ts"
  },
  "dependencies": {
    "fastify": "^5.4.0",
    "@fastify/cors": "^11.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5"
  }
}
