FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /srv
COPY package.json ./package.json
COPY apps/api/package.json ./apps/api/package.json
RUN npm install --omit=dev --workspace @mebe/api --no-audit --no-fund
COPY apps/api/src ./apps/api/src
COPY packages/data/src ./packages/data/src
COPY packages/auth/src ./packages/auth/src
COPY packages/content ./packages/content
COPY scripts ./scripts
COPY apps/web/public/media ./apps/web/public/media
COPY docs/media-review ./docs/media-review
RUN node scripts/generate-media.mjs
COPY database/migrations ./database/migrations
COPY database/certs/prod-ca-2021.crt ./database/certs/prod-ca-2021.crt
ENV SUPABASE_CA_CERT_PATH=/srv/database/certs/prod-ca-2021.crt
USER node
EXPOSE 4000
CMD ["node", "--import", "tsx", "apps/api/src/server.ts"]
